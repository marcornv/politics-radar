# Optional: enables plain-language summaries of bills with Claude.
# Without it the app works normally and shows only the official "ementa".
ANTHROPIC_API_KEY=

# Optional: Claude model used for summaries (default: claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Optional: enables budget amendments (emendas ao orçamento) from the
# Portal da Transparência. Free key: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=
