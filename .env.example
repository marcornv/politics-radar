# Everything here is optional and can also be set in the Configurações screen,
# which takes precedence over this file. Without any AI key the app works
# normally and shows only the official "ementa".

# --- Plain-language summaries: configure one or more providers -------------

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# Groq (needs a model with structured outputs for best results)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Any OpenAI-compatible server: Ollama, LM Studio, OpenRouter...
# COMPATIVEL_URL=http://localhost:11434/v1
# COMPATIVEL_MODELO=llama3.1:8b
# COMPATIVEL_API_KEY=

# Which one to use when several are configured: anthropic, openai, groq or
# compativel. Defaults to the first configured in that order.
# IA_PROVEDOR=

# --- Budget amendments (emendas ao orçamento) -------------------------------
# Portal da Transparência. Free key: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=
